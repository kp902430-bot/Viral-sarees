rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sarees/{sareeId} {
      allow read, write: if true;
    }
    match /reels/{reelId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /customer_logins/{loginId} {
      allow read, write: if true;
    }
    match /otps/{otpId} {
      allow read, write: if true;
    }
  }
}
